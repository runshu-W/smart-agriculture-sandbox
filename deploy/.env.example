# Use ./deploy/configure.sh to create deploy/.env with random passwords.
COMPOSE_PROJECT_NAME=smart-agriculture
APP_PORT=3001
APP_IMAGE=smart-agriculture-app:local
TOOLS_IMAGE=smart-agriculture-tools:local
POSTGRES_IMAGE=postgres:18-alpine
# Must be URL-safe: configure.sh generates a 48-character hexadecimal password.
POSTGRES_PASSWORD=
# Used ONLY by the optional empty-database demo initializer, not normal startup.
DEMO_PASSWORD=
